.env
node_modules/
dist/
prod_modules/
*.log
uploads/
scripts/ollama-batch/.env.ollama-batch
scripts/ollama-batch/.jag-kc-credentials
scripts/doc-import/.env.doc-import

# Claude Code internal state
.claude/worktrees/

# Build artifacts — pre-built tarballs are not source
*.tar.gz

# MS Office temp lock files
~$*.docx
~$*.xlsx

# Data migration — staging payloads and audit logs contain business data
migration/staging/
migration/audit/

# ZAP security scan reports contain auth tokens and PII
security/reports/

# Master Architecture — classified document; offline only; never commit to any cloud system
JAG_Master_Architecture*.docx
JAG_Master_Architecture_generator*.js

# Generated reports & reference exports at repo root (not source — kept local only).
# Keeps the repo to source + text docs, and keeps deploy.sh's auto-commit from sweeping binaries.
/*.html
/*.pdf
/*.docx

# Any .env.* variant in any subdir (e.g. .env.stmt-watcher) — secrets, never track
**/.env.*

# Rendered Grafana alert provisioning file (contains the real webhook token) — only the .template is tracked
jag-infra/grafana/provisioning/alerting/backup-alerts.yml
