# jag-wipay-poc — environment variables
# Copy to .env and fill in values before running

# jag_properties database connection
DATABASE_URL_PROPERTIES=postgres://jag_properties_user:password@localhost:5432/jag_properties

# Shared secret used by WiPay to sign webhook payloads (HMAC-SHA256)
# Obtain from WiPay sandbox dashboard → Webhook Settings → Signing Secret
WIPAY_WEBHOOK_SECRET=your-wipay-hmac-secret

# Robert's UUID in jag_core.users — written to owner_id on all inserted rows
# Set this after completing PRE-4 Step 4 (INSERT into jag_core.users)
OWNER_ID=00000000-0000-0000-0000-000000000000

# Express server port (default: 3000)
PORT=3000
