# JAG Holdings — Caddyfile
#
# Replaces the legacy nginx configuration.
# Caddy handles TLS automatically via Cloudflare DNS-01 (wildcard cert for *.jagcorporate.com).
#
# Env vars required in docker-compose (sourced from .env):
#   CLOUDFLARE_API_TOKEN  — Cloudflare API token with Zone:DNS:Edit for jagcorporate.com
#   ACME_EMAIL            — email for Let's Encrypt registration

{
	email {$ACME_EMAIL}

	# Caddy serves as an edge proxy behind Cloudflare.
	# Keycloak expects KC_PROXY=edge so it trusts X-Forwarded-Proto from Caddy.
}

# ── Shared TLS snippet (Cloudflare DNS-01 wildcard) ──────────────────────────

(cloudflare_tls) {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
}

# ── api.jagcorporate.com — JAG API ───────────────────────────────────────────────────

api.jagcorporate.com {
	import cloudflare_tls

	# Allow large uploads (bank statements, documents — matches multer 20MB limit)
	request_body {
		max_size 25MB
	}

	reverse_proxy api:3000 {
		# Pass real client IP from Cloudflare header to upstream
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}

	# Security headers
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# REST API — no resources to load; block everything
		Content-Security-Policy "default-src 'none'"
		# Allow same-site fetch (jagcorporate.com → api.jagcorporate.com)
		Cross-Origin-Resource-Policy same-site
		-Server
	}
}

# ── auth.jagcorporate.com — Keycloak 26.x ────────────────────────────────────────────

auth.jagcorporate.com {
	import cloudflare_tls

	# Keycloak tokens and admin payloads can be large
	request_body {
		max_size 10MB
	}

	reverse_proxy keycloak:8080 {
		# Pass real client IP from Cloudflare header to upstream
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https

		# Keycloak requires longer timeouts for admin operations and cold start
		transport http {
			dial_timeout 10s
			read_timeout 60s
			write_timeout 60s
		}
	}

	# Keycloak uses iframes for login flows — SAMEORIGIN not DENY
	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Allow same-site fetch (jagcorporate.com → auth.jagcorporate.com)
		Cross-Origin-Resource-Policy same-site
		-Server
	}
}

# ── traccar.jagcorporate.com — Traccar GPS server (own UI + Traccar Manager app) ─────
# Independent fallback view if the JAG app is down. Traccar serves its own SPA and
# sets its own headers, so no strict CSP is imposed here.

traccar.jagcorporate.com {
	import cloudflare_tls

	request_body {
		max_size 10MB
	}

	reverse_proxy traccar:8082 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}

# ── sign.jagcorporate.com — Documenso e-signature (own UI, jag-api reaches it internally) ────
# Tenants/landlord only ever open the /sign/<token> signing page returned by the API —
# never Documenso's own dashboard/login. Embedded as an iframe from jagcorporate.com
# for the on-site handover-checklist signing flow (see frame-src on the SPA block below).
# Same subdomain as the old DocuSeal service — no DNS change needed, just the
# reverse_proxy target below.

sign.jagcorporate.com {
	import cloudflare_tls

	request_body {
		max_size 10MB
	}

	reverse_proxy documenso:3000 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}

# ── storage.jagcorporate.com — MinIO presigned URL public endpoint ───────────────────────────
# Presigned GET/PUT URLs handed to the browser (unit listing photos, VMS compliance
# docs, etc.) are built against this public hostname, not the internal Docker
# network name `minio` — the browser can't resolve that. Found missing entirely
# 2026-07-08 (documented as deployed in session 36, but never actually was — the
# DNS record existed with no Caddy block behind it, causing Cloudflare 525 errors).
# request_body max_size is generous for direct-to-MinIO photo uploads (presigned
# PUT bypasses jag-api entirely, straight browser → MinIO through this proxy).

storage.jagcorporate.com {
	import cloudflare_tls

	request_body {
		max_size 25MB
	}

	reverse_proxy minio:9000 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
}

# ── jagcorporate.com / www.jagcorporate.com — JAG React frontend ─────────────────────────────

jagcorporate.com, www.jagcorporate.com {
	import cloudflare_tls

	header {
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# React SPA — scripts/styles from self; API + auth calls to JAG subdomains;
		# Keycloak iframes allowed for silent token refresh
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://storage.jagcorporate.com; connect-src 'self' https://api.jagcorporate.com https://auth.jagcorporate.com https://storage.jagcorporate.com; font-src 'self'; frame-src https://auth.jagcorporate.com https://sign.jagcorporate.com; object-src 'none'; base-uri 'self'; form-action 'self' https://auth.jagcorporate.com"
		Cross-Origin-Resource-Policy same-origin
		-Server
	}

	# Proxy /api/* to the API container — must be matched before the SPA fallback
	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto https
		}
	}

	# Crawler-only Open Graph preview for shared booking links (see
	# jag-api/src/routes/properties/book-preview.ts) — a static SPA index.html
	# can't carry per-listing meta tags, so link-preview crawlers (which don't
	# execute JS) get a per-unit HTML stub from jag-api instead of the app.
	# Real browsers are never matched here and fall through to the normal SPA
	# route below, which renders the actual booking/viewing-request page.
	@book_crawler {
		path /book/*
		header_regexp UA User-Agent "facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot"
	}
	handle @book_crawler {
		reverse_proxy api:3000 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto https
		}
	}

	# React SPA — fall back to index.html for client-side routing
	handle {
		root * /opt/jag/jag-web/dist
		try_files {path} /index.html
		file_server

		# Cache hashed assets (JS/CSS bundles) forever — content-addressed filenames
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Never cache index.html — ensures browsers always pick up new hashed bundles
		@html not path /assets/*
		header @html Cache-Control "no-cache"
	}
}
