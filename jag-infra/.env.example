# jag-infra — Docker Compose environment variables
# Copy to .env and fill in all values before running docker compose up

# ── Caddy reverse proxy ───────────────────────────────────────────────────────
# Cloudflare API token: Cloudflare dashboard → My Profile → API Tokens
# Scope: Zone → jagcorporate.com → Edit zone DNS
CLOUDFLARE_API_TOKEN=CHANGE_ME_cloudflare_api_token
ACME_EMAIL=robertjohnsonattin@gmail.com

# ── Keycloak database (PostgreSQL role created in bootstrap.sql) ──────────────
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=CHANGE_ME_keycloak_db_password

# ── Keycloak admin console credentials ───────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password

# ── Keycloak hostname — must match the public URL Caddy serves ────────────────
# Dev:  KC_HOSTNAME=localhost
# Prod: KC_HOSTNAME=auth.jagcorporate.com
KC_HOSTNAME=auth.jagcorporate.com

# ── JAG database connection strings ──────────────────────────────────────────
# Use host.docker.internal to reach native PostgreSQL from inside Docker
DATABASE_URL_CORE=postgres://jag_app:CHANGE_ME_app_password@host.docker.internal:5432/jag_core
DATABASE_URL_COMMERCIAL=postgres://jag_app:CHANGE_ME_app_password@host.docker.internal:5432/jag_commercial
DATABASE_URL_ENTERTAINMENT=postgres://jag_app:CHANGE_ME_app_password@host.docker.internal:5432/jag_entertainment
DATABASE_URL_FAMILY=postgres://jag_app:CHANGE_ME_app_password@host.docker.internal:5432/jag_family
DATABASE_URL_PROPERTIES=postgres://jag_app:CHANGE_ME_app_password@host.docker.internal:5432/jag_properties

# ── JAG API — Keycloak connection ─────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/jag
KEYCLOAK_REALM=jag
KEYCLOAK_CLIENT_ID=jag-api

# ── Event dispatcher ──────────────────────────────────────────────────────────
# Robert's UUID in jag_core.users — set after Keycloak realm import (PRE-4 Step 4)
ALERT_USER_ID=00000000-0000-0000-0000-000000000000

# ── WiPay ────────────────────────────────────────────────────────────────────
# Retrieve WIPAY_WEBHOOK_SECRET from the WiPay merchant dashboard
WIPAY_WEBHOOK_SECRET=CHANGE_ME_wipay_webhook_secret
# Set to Robert's real users.id AFTER first Keycloak login and set-user-tenant.sh
WIPAY_DEFAULT_OWNER_ID=00000000-0000-0000-0000-000000000000

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=jag_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET_STATEMENTS=jag-bank-statements

# ── Keycloak WebAuthn (F-11) ──────────────────────────────────────────────────
# rpId MUST match the domain the browser uses when authenticating.
# Set to localhost for dev, jagcorporate.com for production — set BEFORE any user registers
# a device. Run: KC_WEBAUTHN_RP_ID=jagcorporate.com ./scripts/keycloak-webauthn-setup.sh
KC_WEBAUTHN_RP_ID=localhost

# ── Grafana ───────────────────────────────────────────────────────────────────
# Access Grafana via SSH tunnel: ssh -L 3001:localhost:3001 user@vm
# Then open http://localhost:3001 in your browser.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
