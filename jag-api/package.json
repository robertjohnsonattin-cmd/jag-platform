{
  "name": "jag-api",
  "version": "1.0.0",
  "private": true,
  "description": "JAG Holdings Platform — main API service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:prod": "tsc --project tsconfig.build.json",
    "prod-install": "node scripts/prod-install.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:rls": "jest --testPathPattern=rls-isolation --verbose --forceExit --runInBand",
    "batch:statements": "ts-node-dev src/batch/bank-statement-batch.ts",
    "build:batch": "tsc --project ../scripts/ollama-batch/tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.7.0",
    "jimp": "^1.6.1",
    "jose": "^5.10.0",
    "minio": "^8.0.7",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.15.2",
    "pg": "^8.12.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testTimeout": 30000,
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    }
  }
}
