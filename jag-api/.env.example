# JAG API — environment variables
# Copy to .env (never commit .env)

# Database connection strings (same PostgreSQL instance, 5 logical DBs)
DATABASE_URL_CORE=postgresql://jag_app:CHANGE_ME@host.docker.internal:5432/jag_core
DATABASE_URL_COMMERCIAL=postgresql://jag_app:CHANGE_ME@host.docker.internal:5432/jag_commercial
DATABASE_URL_ENTERTAINMENT=postgresql://jag_app:CHANGE_ME@host.docker.internal:5432/jag_entertainment
DATABASE_URL_FAMILY=postgresql://jag_app:CHANGE_ME@host.docker.internal:5432/jag_family
DATABASE_URL_PROPERTIES=postgresql://jag_app:CHANGE_ME@host.docker.internal:5432/jag_properties

# Test/migration superuser connections (used ONLY by the RLS pen-test suite — never in production API)
# Use the same jag_migrator credentials that run node-pg-migrate migrations.
DATABASE_URL_CORE_SUPER=postgresql://jag_migrator:CHANGE_ME@host.docker.internal:5432/jag_core
DATABASE_URL_COMMERCIAL_SUPER=postgresql://jag_migrator:CHANGE_ME@host.docker.internal:5432/jag_commercial
DATABASE_URL_ENTERTAINMENT_SUPER=postgresql://jag_migrator:CHANGE_ME@host.docker.internal:5432/jag_entertainment
DATABASE_URL_FAMILY_SUPER=postgresql://jag_migrator:CHANGE_ME@host.docker.internal:5432/jag_family
DATABASE_URL_PROPERTIES_SUPER=postgresql://jag_migrator:CHANGE_ME@host.docker.internal:5432/jag_properties

# Keycloak
# KEYCLOAK_URL     — internal URL used inside Docker to reach Keycloak for JWKS fetching.
#                    Typically http://keycloak:8080 in Docker Compose.
# KEYCLOAK_ISSUER_URL — public URL that Keycloak embeds in JWT iss claims (set by KC_HOSTNAME).
#                    Defaults to KEYCLOAK_URL if omitted. Override when Keycloak is behind a
#                    reverse proxy and the internal/external URLs differ.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ISSUER_URL=http://localhost:8080
KEYCLOAK_REALM=jag
KEYCLOAK_CLIENT_ID=jag-api

# Keycloak Admin REST API — service account for writing jag_user_id attribute on first login.
# Requires a confidential client or service account with the manage-users realm role.
# Leave blank to disable write-back (auth middleware DB fallback will be used instead).
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# WiPay — T&T payment gateway
# WIPAY_API_KEY         — from WiPay merchant dashboard
# WIPAY_WEBHOOK_SECRET  — used to verify X-WiPay-Signature on incoming webhooks
# WIPAY_DEFAULT_OWNER_ID— jag_core.users.id for Robert (not Keycloak sub — internal UUID)
# WIPAY_BASE_URL        — sandbox: https://sandbox.wipayfinancial.com
#                         production: https://wipayfinancial.com
WIPAY_API_KEY=CHANGE_ME
WIPAY_WEBHOOK_SECRET=CHANGE_ME
WIPAY_DEFAULT_OWNER_ID=CHANGE_ME
WIPAY_BASE_URL=https://sandbox.wipayfinancial.com

# MinIO — self-hosted object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_DOCVAULT=jag-docvault

# API
PORT=3000
NODE_ENV=development
