  ims_barcodes
  ims_photos
  ims_stock_movements
}

TableGroup jabco_pm {
  jabco_projects
  jabco_boq_items
  jabco_variation_orders
  jabco_progress_claims
  jabco_payment_certificates
  jabco_subcontractor_retention
  jabco_site_diary
  jabco_project_gantt
}

TableGroup crm {
  crm_companies
  crm_contacts
  crm_interactions
  crm_sales_pipeline
}
