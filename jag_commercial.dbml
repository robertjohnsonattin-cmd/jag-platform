// ============================================================
// JAG Platform — jag_commercial Database Schema
// ============================================================
// Version:    PRE-1 | 2026-05-23
// Author:     Robert Johnson-Attin via Claude Code (PRE-1 session)
// Tooling:    node-pg-migrate | dbdiagram.io compatible
//
// jag_commercial covers three domains:
//   IMS  — Inventory Management System (all locations, all assets,
//           JABCO tool crib, JABCO FLEET, personal FLEET items)
//   JABCO — Full construction PM lifecycle
//   CRM   — Contact master, JABCO sales pipeline, DragonBridge
//
// RLS: tenant_id on all tables.
//   SET LOCAL app.current_tenant = '<uuid>';
//
// Offline-critical tables carry last_modified_at + last_modified_by:
//   IMS barcode scanning, JABCO site diary.
//   Non-conflicting updates auto-merge on reconnect.
//   Conflicts route to Conflict Review queue.
//
// Cross-DB references (no DB-level FK — logical only):
//   tenant_id → jag_core.tenants.id
//   user references (performed_by, assigned_to etc.) → jag_core.users.id
//
// Standards: STD-01 through STD-13 apply to all changes.
// ============================================================


// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

Enum item_condition {
  NEW
  GOOD
  FAIR
  POOR
  WRITTEN_OFF
}

Enum movement_type {
  RECEIVE
  TRANSFER
  ADJUSTMENT
  CONSUME
  RETURN
  DISPOSAL
}

Enum vehicle_type {
  CAR
  SUV
  TRUCK
  VAN
  EXCAVATOR
  COMPACTOR
  ROLLER
  CRANE
  GENERATOR
  TRAILER
  MOTORCYCLE
  OTHER
}

Enum project_status {
  TENDER
  ACTIVE
  PRACTICAL_COMPLETION
  DEFECTS_LIABILITY
  CLOSED
  CANCELLED
}

Enum vo_status {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

Enum claim_status {
  DRAFT
  SUBMITTED
  CERTIFIED
  PAID
  DISPUTED
}

Enum retention_status {
  HOLDING
  PARTIALLY_RELEASED
  FULLY_RELEASED
}

Enum pipeline_stage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

Enum sync_status {
  SYNCED
  PENDING_SYNC
}


// ------------------------------------------------------------
// OUTBOX: pending_events
// ------------------------------------------------------------

Table pending_events {
  id              uuid         [pk, default: `gen_random_uuid()`]
  aggregate_type  varchar      [not null, note: 'e.g. ImsItem, JabcoProject, CrmContact']
  aggregate_id    uuid         [not null]
  event_type      varchar      [not null, note: 'e.g. ims.stock_low, jabco.claim_certified, crm.lead_won']
  payload         jsonb        [not null]
  created_at      timestamptz  [not null, default: `now()`]
  processed_at    timestamptz  [null]
  retry_count     integer      [not null, default: 0]
  last_error      text         [null]

  indexes {
    processed_at                    [name: 'idx_pe_comm_processed_at']
    created_at                      [name: 'idx_pe_comm_created_at']
    (aggregate_type, aggregate_id)  [name: 'idx_pe_comm_aggregate']
  }

  Note: 'Append-only outbox. jag-event-dispatcher polls every 5s.'
}


// ============================================================
// IMS — INVENTORY MANAGEMENT SYSTEM
// ============================================================

// ------------------------------------------------------------
// IMS_LOCATIONS — physical locations for inventory
// ------------------------------------------------------------

Table ims_locations {
  id              uuid         [pk, default: `gen_random_uuid()`]
  tenant_id       uuid         [not null, note: 'cross-db ref: jag_core.tenants.id']
  code            varchar      [not null, note: 'e.g. BARATARIA_HOME, FYZABAD_HOME, JABCO_OFFICE, JABCO_YARD']
  name            varchar      [not null]
  address         text         [null]
  is_active       boolean      [not null, default: true]
  last_modified_at timestamptz [not null, default: `now()`]
  last_modified_by uuid        [not null, note: 'cross-db ref: jag_core.users.id']
  created_at      timestamptz  [not null, default: `now()`]
  updated_at      timestamptz  [not null, default: `now()`]

  indexes {
    tenant_id  [name: 'idx_ims_locations_tenant']
    code       [name: 'idx_ims_locations_code']
  }

  Note: 'RLS: tenant_id. Seed locations: Barataria Home, Fyzabad Home, JABCO Office/Yard.'
}


// ------------------------------------------------------------
// IMS_CATEGORIES — hierarchical item categories
// ------------------------------------------------------------

Table ims_categories {
  id                 uuid         [pk, default: `gen_random_uuid()`]
  tenant_id          uuid         [not null, note: 'cross-db ref: jag_core.tenants.id']
  name               varchar      [not null]
  parent_category_id uuid         [null, note: 'Self-ref for hierarchy e.g. Tools > Power Tools']
  description        text         [null]
  last_modified_at   timestamptz  [not null, default: `now()`]
  created_at         timestamptz  [not null, default: `now()`]
  updated_at         timestamptz  [not null, default: `now()`]

  indexes {
    tenant_id          [name: 'idx_ims_cat_tenant']
    parent_category_id [name: 'idx_ims_cat_parent']
  }

  Note: 'RLS: tenant_id.'
}

Ref: ims_categories.parent_category_id > ims_categories.id


// ------------------------------------------------------------
// IMS_TAGS — flexible item labels
// ------------------------------------------------------------

Table ims_tags {
  id         uuid         [pk, default: `gen_random_uuid()`]
  tenant_id  uuid         [not null, note: 'cross-db ref: jag_core.tenants.id']
  name       varchar      [not null]
  color      varchar      [null, note: 'Hex color for UI display e.g. #FF5733']
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]

  indexes {
    tenant_id [name: 'idx_ims_tags_tenant']
  }
}


// ------------------------------------------------------------
// IMS_ITEMS — all physical assets and inventory across all locations
// Covers: tools, equipment, supplies, vehicles (JABCO + personal),
//         materials, appliances, household items
// ------------------------------------------------------------

Table ims_items {
  id                uuid          [pk, default: `gen_random_uuid()`]
  tenant_id         uuid          [not null, note: 'cross-db ref: jag_core.tenants.id']
  location_id       uuid          [not null, ref: > ims_locations.id]
  category_id       uuid          [null, ref: > ims_categories.id]
  name              varchar       [not null]
  description       text          [null]
  sku               varchar       [null, note: 'Unique per tenant — used for barcode generation']
  unit_of_measure   varchar       [not null, default: 'each', note: 'each | kg | m | L | m2 | m3']
  quantity_on_hand  numeric       [not null, default: 0]
  quantity_reserved numeric       [not null, default: 0]
  reorder_point     numeric       [null]
  unit_value        numeric       [null, note: 'Asset valuation — not a sale price']
  serial_number     varchar       [null]
  condition         item_condition [not null, default: 'GOOD']
  is_asset          boolean       [not null, default: false, note: 'True for capital assets (vehicles, equipment). False for consumables.']
  is_active         boolean       [not null, default: true]
  last_modified_at  timestamptz   [not null, default: `now()`]
  last_modified_by  uuid          [not null, note: 'cross-db ref: jag_core.users.id']
  created_at        timestamptz   [not null, default: `now()`]
  updated_at        timestamptz   [not null, default: `now()`]

  indexes {
    tenant_id              [name: 'idx_ims_items_tenant']
    location_id            [name: 'idx_ims_items_location']
    category_id            [name: 'idx_ims_items_category']
    sku                    [name: 'idx_ims_items_sku']
    last_modified_at       [name: 'idx_ims_items_last_modified']
  }

  Note: 'RLS: tenant_id. JABCO FLEET and personal FLEET vehicles are items with is_asset=true and category VEHICLE. ims_vehicles extends this table with vehicle-specific fields.'
}


// ------------------------------------------------------------
// IMS_VEHICLES — vehicle-specific detail extending ims_items
// Covers both JABCO fleet (trucks, excavators) and personal fleet
// ------------------------------------------------------------

Table ims_vehicles {
  id                       uuid          [pk, default: `gen_random_uuid()`]
  tenant_id                uuid          [not null, note: 'cross-db ref: jag_core.tenants.id']
  item_id                  uuid          [not null, unique, ref: > ims_items.id, note: 'One-to-one extension of ims_items']
  fleet_type               varchar       [not null, note: 'JABCO_FLEET | PERSONAL_FLEET']
  registration_number      varchar       [not null]
  make                     varchar       [not null]
  model                    varchar       [not null]
  year                     integer       [not null]
  colour                   varchar       [null]
  vehicle_type             vehicle_type  [not null]
  fuel_type                varchar       [not null, note: 'PETROL | DIESEL | HYBRID | ELECTRIC | NONE']
  vin                      varchar       [null]
  engine_number            varchar       [null]
  insurance_policy_number  varchar       [null]
  insurance_provider       varchar       [null]
  insurance_expiry         date          [null]
  registration_expiry      date          [null]
  purchase_date            date          [null]
  purchase_price           numeric       [null]
  current_mileage_km       integer       [null]
  assigned_to_user_id      uuid          [null, note: 'cross-db ref: jag_core.users.id — primary driver/user']
  last_modified_at         timestamptz   [not null, default: `now()`]
  last_modified_by         uuid          [not null, note: 'cross-db ref: jag_core.users.id']
  created_at               timestamptz   [not null, default: `now()`]
  updated_at               timestamptz   [not null, default: `now()`]

  indexes {
    tenant_id           [name: 'idx_ims_veh_tenant']
    registration_number [name: 'idx_ims_veh_rego']
    fleet_type          [name: 'idx_ims_veh_fleet_type']
    insurance_expiry    [name: 'idx_ims_veh_ins_expiry', note: 'Alert queries']
    registration_expiry [name: 'idx_ims_veh_rego_expiry', note: 'Alert queries']
  }

  Note: 'RLS: tenant_id. Personal fleet records also have a counterpart in jag_family.fam_personal_vehicles for family-admin data (licence, next-of-kin assignment). Cross-DB reference held as ims_item_id in jag_family.'
}


// ------------------------------------------------------------
// IMS_ITEM_TAGS — junction: items ↔ tags
// ------------------------------------------------------------

Table ims_item_tags {
  id         uuid         [pk, default: `gen_random_uuid()`]
  item_id    uuid         [not null, ref: > ims_items.id]
  tag_id     uuid         [not null, ref: > ims_tags.id]
  created_at timestamptz  [not null, default: `now()`]

  indexes {
    (item_id, tag_id) [unique, name: 'idx_ims_item_tags_pair']
  }
}


// ------------------------------------------------------------
// IMS_BARCODES — QR / barcode records for items
// ------------------------------------------------------------

Table ims_barcodes {
  id             uuid         [pk, default: `gen_random_uuid()`]
  tenant_id      uuid         [not null, note: 'cross-db ref: jag_core.tenants.id']
  item_id        uuid         [not null, ref: > ims_items.id]
  barcode_value  varchar      [not null, unique]
  barcode_type   varchar      [not null, note: 'QR | CODE128 | EAN13 | EAN8 | DATAMATRIX']
  is_primary     boolean      [not null, default: false]
  created_at     timestamptz  [not null, default: `now()`]
  updated_at     timestamptz  [not null, default: `now()`]

  indexes {
    tenant_id     [name: 'idx_ims_barcodes_tenant']
    item_id       [name: 'idx_ims_barcodes_item']
    barcode_value [unique, name: 'idx_ims_barcodes_value']
  }

  Note: 'RLS: tenant_id. barcode_value uniqueness is platform-wide to prevent scan collisions.'
}


// ------------------------------------------------------------
// IMS_PHOTOS — item photos stored in MinIO
// ------------------------------------------------------------

Table ims_photos {
  id            uuid         [pk, default: `gen_random_uuid()`]
  tenant_id     uuid         [not null, note: 'cross-db ref: jag_core.tenants.id']
  item_id       uuid         [not null, ref: > ims_items.id]
  storage_path  varchar      [not null, note: 'MinIO object path e.g. ims/items/{item_id}/{uuid}.jpg']
  is_primary    boolean      [not null, default: false]
  uploaded_by   uuid         [not null, note: 'cross-db ref: jag_core.users.id']
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]

  indexes {
    tenant_id [name: 'idx_ims_photos_tenant']
    item_id   [name: 'idx_ims_photos_item']
  }
}


// ------------------------------------------------------------
// IMS_STOCK_MOVEMENTS — every quantity change leaves a trail
// ------------------------------------------------------------

Table ims_stock_movements {
  id                uuid          [pk, default: `gen_random_uuid()`]
  tenant_id         uuid          [not null, note: 'cross-db ref: jag_core.tenants.id']
  item_id           uuid          [not null, ref: > ims_items.id]
  from_location_id  uuid          [null, ref: > ims_locations.id]
  to_location_id    uuid          [null, ref: > ims_locations.id]
  quantity          numeric       [not null]
  movement_type     movement_type [not null]
  reference_type    varchar       [null, note: 'e.g. JABCO_PROJECT, PURCHASE_ORDER — links to source document']
  reference_id      uuid          [null, note: 'ID of the reference document']
  notes             text          [null]
  performed_by      uuid          [not null, note: 'cross-db ref: jag_core.users.id']
  idempotency_key   uuid          [not null, unique]
  last_modified_at  timestamptz   [not null, default: `now()`]
  created_at        timestamptz   [not null, default: `now()`]
  updated_at        timestamptz   [not null, default: `now()`]

  indexes {
    tenant_id        [name: 'idx_ims_movements_tenant']
    item_id          [name: 'idx_ims_movements_item']
    (reference_type, reference_id) [name: 'idx_ims_movements_ref']
    idempotency_key  [unique, name: 'idx_ims_movements_idempotency']
    last_modified_at [name: 'idx_ims_movements_last_modified']
  }

  Note: 'RLS: tenant_id. Offline-critical — sync_status not tracked here; tracked at application layer. idempotency_key prevents duplicate posting on reconnect (STD-11).'
}


// ============================================================
// JABCO — CONSTRUCTION PROJECT MANAGEMENT
// ============================================================

// ------------------------------------------------------------
// JABCO_PROJECTS — contract-level master record
// ------------------------------------------------------------

Table jabco_projects {
  id                  uuid           [pk, default: `gen_random_uuid()`]
  tenant_id           uuid           [not null, note: 'cross-db ref: jag_core.tenants.id — always JABCO tenant']
  project_code        varchar        [not null, unique]
  name                varchar        [not null]
  client_name         varchar        [not null]
  client_type         varchar        [not null, note: 'GOVERNMENT | PRIVATE']
  status              project_status [not null, default: 'TENDER']
  contract_value      numeric        [not null]
  contract_currency   varchar(3)     [not null, default: 'TTD']
  start_date          date           [null]
  expected_end_date   date           [null]
  actual_end_date     date           [null]
  site_address        text           [null]
  project_manager_id  uuid           [not null, note: 'cross-db ref: jag_core.users.id']
  idempotency_key     uuid           [not null, unique]
  last_modified_at    timestamptz    [not null, default: `now()`]
  last_modified_by    uuid           [not null, note: 'cross-db ref: jag_core.users.id']
  created_at          timestamptz    [not null, default: `now()`]
  updated_at          timestamptz    [not null, default: `now()`]

  indexes {
    tenant_id        [name: 'idx_jabco_proj_tenant']
    status           [name: 'idx_jabco_proj_status']
    project_code     [unique, name: 'idx_jabco_proj_code']
    idempotency_key  [unique, name: 'idx_jabco_proj_idempotency']
    last_modified_at [name: 'idx_jabco_proj_last_modified']
  }

  Note: 'RLS: tenant_id. Offline sync supported — foremen access project data offline. Financial amounts in TTD by default; multi-currency for government contracts.'
}


// ------------------------------------------------------------
// JABCO_BOQ_ITEMS — Bill of Quantities: budgeted vs actual
// ------------------------------------------------------------

Table jabco_boq_items {
  id               uuid        [pk, default: `gen_random_uuid()`]
  tenant_id        uuid        [not null, note: 'cross-db ref: jag_core.tenants.id']
  project_id       uuid        [not null, ref: > jabco_projects.id]
  section          varchar     [not null, note: 'e.g. Earthworks, Concrete Works, Drainage']
  item_number      varchar     [null, note: 'BOQ line item reference number']
  description      text        [not null]
  unit             varchar     [not null, note: 'e.g. m3, m2, lm, sum, item']
  quantity_budgeted numeric    [not null]
  unit_rate        numeric     [not null]
  amount_budgeted  numeric     [not null, note: 'quantity_budgeted × unit_rate — denormalised for reporting']
  quantity_actual  numeric     [not null, default: 0]
  amount_actual    numeric     [not null, default: 0]
  last_modified_at timestamptz [not null, default: `now()`]
  created_at       timestamptz [not null, default: `now()`]
  updated_at       timestamptz [not null, default: `now()`]

  indexes {
    tenant_id  [name: 'idx_boq_tenant']
    project_id [name: 'idx_boq_project']
  }

  Note: 'RLS: tenant_id.'
}


// ------------------------------------------------------------
// JABCO_VARIATION_ORDERS — contract changes post-award
// ------------------------------------------------------------

Table jabco_variation_orders {
  id              uuid       [pk, default: `gen_random_uuid()`]
  tenant_id       uuid       [not null, note: 'cross-db ref: jag_core.tenants.id']
  project_id      uuid       [not null, ref: > jabco_projects.id]
  vo_number       varchar    [not null]
  description     text       [not null]
  status          vo_status  [not null, default: 'PENDING']
  amount          numeric    [not null]
  currency        varchar(3) [not null, default: 'TTD']
  submitted_date  date       [null]
  approved_date   date       [null]
  approved_by     uuid       [null, note: 'cross-db ref: jag_core.users.id']
  idempotency_key uuid       [not null, unique]
  last_modified_at timestamptz [not null, default: `now()`]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]

  indexes {
    tenant_id       [name: 'idx_vo_tenant']
    project_id      [name: 'idx_vo_project']
    status          [name: 'idx_vo_status']
    idempotency_key [unique, name: 'idx_vo_idempotency']
  }

  Note: 'RLS: tenant_id.'
}


// ------------------------------------------------------------
// JABCO_PROGRESS_CLAIMS — periodic payment applications
// ------------------------------------------------------------

Table jabco_progress_claims {
  id               uuid         [pk, default: `gen_random_uuid()`]
  tenant_id        uuid         [not null, note: 'cross-db ref: jag_core.tenants.id']
  project_id       uuid         [not null, ref: > jabco_projects.id]
  claim_number     integer      [not null]
  period_from      date         [not null]
  period_to        date         [not null]
  amount_claimed   numeric      [not null]
  amount_certified numeric      [null]
  status           claim_status [not null, default: 'DRAFT']
  submitted_date   date         [null]
  certified_date   date         [null]
  paid_date        date         [null]
  idempotency_key  uuid         [not null, unique]
  last_modified_at timestamptz  [not null, default: `now()`]
  created_at       timestamptz  [not null, default: `now()`]
  updated_at       timestamptz  [not null, default: `now()`]

  indexes {
    tenant_id       [name: 'idx_claims_tenant']
    project_id      [name: 'idx_claims_project']
    status          [name: 'idx_claims_status']
    idempotency_key [unique, name: 'idx_claims_idempotency']
  }

  Note: 'RLS: tenant_id. Financial write — idempotency_key required (STD-11).'
}


// ------------------------------------------------------------
// JABCO_PAYMENT_CERTIFICATES — issued by client on claim approval
// ------------------------------------------------------------

Table jabco_payment_certificates {
  id                 uuid        [pk, default: `gen_random_uuid()`]
  tenant_id          uuid        [not null, note: 'cross-db ref: jag_core.tenants.id']
  progress_claim_id  uuid        [not null, ref: > jabco_progress_claims.id]
  certificate_number varchar     [not null]
  amount_certified   numeric     [not null]
  issued_date        date        [not null]
  due_date           date        [null]
  paid_date          date        [null]
  idempotency_key    uuid        [not null, unique]
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null, default: `now()`]

  indexes {
    tenant_id         [name: 'idx_pc_tenant']
    progress_claim_id [name: 'idx_pc_claim']
    idempotency_key   [unique, name: 'idx_pc_idempotency']
  }
}


// ------------------------------------------------------------
// JABCO_SUBCONTRACTOR_RETENTION — withheld amounts per subcontractor
// ------------------------------------------------------------

Table jabco_subcontractor_retention {
  id                        uuid             [pk, default: `gen_random_uuid()`]
  tenant_id                 uuid             [not null, note: 'cross-db ref: jag_core.tenants.id']
  project_id                uuid             [not null, ref: > jabco_projects.id]
  subcontractor_name        varchar          [not null]
  subcontractor_contact     varchar          [null]
  contract_amount           numeric          [not null]
  retention_percentage      numeric          [not null, default: 5.00]
  retention_amount_held     numeric          [not null]
  retention_released        numeric          [not null, default: 0]
  release_condition         varchar          [not null, note: 'PRACTICAL_COMPLETION | DEFECTS_LIABILITY_EXPIRY']
  defects_liability_expiry  date             [null]
  status                    retention_status [not null, default: 'HOLDING']
  idempotency_key           uuid             [not null, unique]
  last_modified_at          timestamptz      [not null, default: `now()`]
  created_at                timestamptz      [not null, default: `now()`]
  updated_at                timestamptz      [not null, default: `now()`]

  indexes {
    tenant_id              [name: 'idx_retention_tenant']
    project_id             [name: 'idx_retention_project']
    defects_liability_expiry [name: 'idx_retention_dl_expiry', note: 'Alert queries for release reminders']
    idempotency_key        [unique, name: 'idx_retention_idempotency']
  }

  Note: 'RLS: tenant_id. Financial write — idempotency_key required (STD-11).'
}


// ------------------------------------------------------------
// JABCO_SITE_DIARY — foreman daily log (offline-critical)
// ------------------------------------------------------------

Table jabco_site_diary {
  id                    uuid        [pk, default: `gen_random_uuid()`]
  tenant_id             uuid        [not null, note: 'cross-db ref: jag_core.tenants.id']
  project_id            uuid        [not null, ref: > jabco_projects.id]
  foreman_id            uuid        [not null, note: 'cross-db ref: jag_core.users.id']
  entry_date            date        [not null]
  weather               varchar     [null]
  workers_on_site       integer     [null]
  activities_completed  text        [null]
  materials_received    text        [null]
  equipment_on_site     text        [null]
  instructions_received text        [null]
  issues_noted          text        [null]
  photos                jsonb       [null, note: 'Array of MinIO storage paths']
  sync_status           sync_status [not null, default: 'SYNCED']
  last_modified_at      timestamptz [not null, default: `now()`]
  last_modified_by      uuid        [not null, note: 'cross-db ref: jag_core.users.id']
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null, default: `now()`]

  indexes {
    tenant_id        [name: 'idx_diary_tenant']
    project_id       [name: 'idx_diary_project']
    foreman_id       [name: 'idx_diary_foreman']
    entry_date       [name: 'idx_diary_date']
    sync_status      [name: 'idx_diary_sync_status']
    last_modified_at [name: 'idx_diary_last_modified']
  }

  Note: 'RLS: tenant_id. OFFLINE-CRITICAL: sync_status tracks pending-sync records. Conflicts route to Conflict Review queue — non-conflicting updates auto-merge. Mobile PWA foreman app writes here.'
}


// ------------------------------------------------------------
// JABCO_PROJECT_GANTT — programme vs actuals tracking
// ------------------------------------------------------------

Table jabco_project_gantt {
  id                    uuid        [pk, default: `gen_random_uuid()`]
  tenant_id             uuid        [not null, note: 'cross-db ref: jag_core.tenants.id']
  project_id            uuid        [not null, ref: > jabco_projects.id]
  task_name             varchar     [not null]
  planned_start         date        [not null]
  planned_end           date        [not null]
  actual_start          date        [null]
  actual_end            date        [null]
  predecessor_id        uuid        [null, note: 'Self-ref for task dependencies']
  completion_percentage numeric     [not null, default: 0]
  last_modified_at      timestamptz [not null, default: `now()`]
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null, default: `now()`]

  indexes {
    tenant_id    [name: 'idx_gantt_tenant']
    project_id   [name: 'idx_gantt_project']
    predecessor_id [name: 'idx_gantt_predecessor']
  }
}

Ref: jabco_project_gantt.predecessor_id > jabco_project_gantt.id


// ============================================================
// CRM — CONTACT AND SALES MANAGEMENT
// ============================================================

// ------------------------------------------------------------
// CRM_COMPANIES — organisation-level contact records
// ------------------------------------------------------------

Table crm_companies {
  id               uuid        [pk, default: `gen_random_uuid()`]
  tenant_id        uuid        [not null, note: 'cross-db ref: jag_core.tenants.id']
  name             varchar     [not null]
  industry         varchar     [null]
  country          varchar     [not null, default: 'TT']
  phone            varchar     [null]
  email            varchar     [null]
  website          varchar     [null]
  notes            text        [null]
  last_modified_at timestamptz [not null, default: `now()`]
  created_at       timestamptz [not null, default: `now()`]
  updated_at       timestamptz [not null, default: `now()`]

  indexes {
    tenant_id [name: 'idx_crm_companies_tenant']
  }

  Note: 'RLS: tenant_id. Shared master record for JABCO clients, DragonBridge partners, and potential acquisitions.'
}


// ------------------------------------------------------------
// CRM_CONTACTS — individual contact records
// ------------------------------------------------------------

Table crm_contacts {
  id                 uuid        [pk, default: `gen_random_uuid()`]
  tenant_id          uuid        [not null, note: 'cross-db ref: jag_core.tenants.id']
  company_id         uuid        [null, ref: > crm_companies.id]
  first_name         varchar     [not null]
  last_name          varchar     [not null]
  email              varchar     [null]
  phone              varchar     [null]
  role               varchar     [null, note: 'e.g. Project Manager, Procurement Officer, Director']
  preferred_language varchar(5)  [not null, default: 'en']
  loyalty_member_id  uuid        [null, note: 'cross-db ref: jag_family.fam_loyalty_programmes.id — JAG Lifestyle integration point']
  notes              text        [null]
  last_modified_at   timestamptz [not null, default: `now()`]
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null, default: `now()`]

  indexes {
    tenant_id    [name: 'idx_crm_contacts_tenant']
    company_id   [name: 'idx_crm_contacts_company']
    email        [name: 'idx_crm_contacts_email']
  }

  Note: 'RLS: tenant_id. loyalty_member_id is a cross-DB logical reference to JAG Lifestyle loyalty programme (no DB-level FK).'
}


// ------------------------------------------------------------
// CRM_INTERACTIONS — contact activity log
// ------------------------------------------------------------

Table crm_interactions {
  id               uuid        [pk, default: `gen_random_uuid()`]
  tenant_id        uuid        [not null, note: 'cross-db ref: jag_core.tenants.id']
  contact_id       uuid        [not null, ref: > crm_contacts.id]
  user_id          uuid        [not null, note: 'cross-db ref: jag_core.users.id — who logged this']
  interaction_type varchar     [not null, note: 'CALL | EMAIL | MEETING | SITE_VISIT | OTHER']
  subject          varchar     [not null]
  notes            text        [null]
  occurred_at      timestamptz [not null]
  follow_up_date   date        [null]
  created_at       timestamptz [not null, default: `now()`]
  updated_at       timestamptz [not null, default: `now()`]

  indexes {
    tenant_id    [name: 'idx_crm_inter_tenant']
    contact_id   [name: 'idx_crm_inter_contact']
    occurred_at  [name: 'idx_crm_inter_occurred_at']
    follow_up_date [name: 'idx_crm_inter_follow_up']
  }

  Note: 'RLS: tenant_id.'
}


// ------------------------------------------------------------
// CRM_SALES_PIPELINE — JABCO project pipeline and DragonBridge deals
// ------------------------------------------------------------

Table crm_sales_pipeline {
  id                   uuid           [pk, default: `gen_random_uuid()`]
  tenant_id            uuid           [not null, note: 'cross-db ref: jag_core.tenants.id']
  contact_id           uuid           [null, ref: > crm_contacts.id]
  company_id           uuid           [null, ref: > crm_companies.id]
  title                varchar        [not null]
  stage                pipeline_stage [not null, default: 'LEAD']
  estimated_value      numeric        [null]
  currency             varchar(3)     [not null, default: 'TTD']
  probability_percent  integer        [null]
  expected_close_date  date           [null]
  assigned_to          uuid           [not null, note: 'cross-db ref: jag_core.users.id']
  notes                text           [null]
  idempotency_key      uuid           [not null, unique]
  last_modified_at     timestamptz    [not null, default: `now()`]
  created_at           timestamptz    [not null, default: `now()`]
  updated_at           timestamptz    [not null, default: `now()`]

  indexes {
    tenant_id       [name: 'idx_pipeline_tenant']
    stage           [name: 'idx_pipeline_stage']
    assigned_to     [name: 'idx_pipeline_assigned']
    idempotency_key [unique, name: 'idx_pipeline_idempotency']
  }

  Note: 'RLS: tenant_id. Used for JABCO construction tendering and DragonBridge deal tracking. DragonBridge sub-architecture session required before Phase 3.'
}


