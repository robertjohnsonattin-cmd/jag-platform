# jag-bank-parser-poc — environment variables
# Copy to .env and fill in values before running

# Ollama local API endpoint (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Ollama model to use — must be pulled first: ollama pull mistral
OLLAMA_MODEL=mistral

# Maximum characters of statement text to send in one LLM call.
# Mistral 7B context window is ~32K tokens (~24K chars is a safe ceiling).
# For longer statements, the text is truncated with a warning.
MAX_TEXT_CHARS=24000
