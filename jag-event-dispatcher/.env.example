# JAG Event Dispatcher — Environment Variables
# Copy this file to .env and fill in the values.

# PostgreSQL connection strings — one per database
DATABASE_URL_CORE=postgresql://jag_app:password@localhost:5432/jag_core
DATABASE_URL_COMMERCIAL=postgresql://jag_app:password@localhost:5432/jag_commercial
DATABASE_URL_ENTERTAINMENT=postgresql://jag_app:password@localhost:5432/jag_entertainment
DATABASE_URL_FAMILY=postgresql://jag_app:password@localhost:5432/jag_family
DATABASE_URL_PROPERTIES=postgresql://jag_app:password@localhost:5432/jag_properties

# UUID of the Owner (Robert) in jag_core.users — used for Tier 1 system alerts
ALERT_USER_ID=

# Dispatcher tuning (defaults shown)
POLL_INTERVAL_MS=5000
BATCH_SIZE=10
MAX_RETRIES=3
