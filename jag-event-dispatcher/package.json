{
  "name": "jag-event-dispatcher",
  "version": "1.0.0",
  "description": "JAG Platform outbox event dispatcher — polls all five pending_events tables and routes events to registered handlers",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:core": "tsx scripts/migrate.ts core",
    "migrate:commercial": "tsx scripts/migrate.ts commercial",
    "migrate:entertainment": "tsx scripts/migrate.ts entertainment",
    "migrate:family": "tsx scripts/migrate.ts family",
    "migrate:properties": "tsx scripts/migrate.ts properties",
    "migrate:all": "tsx scripts/migrate.ts all"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-pg-migrate": "^7.3.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
